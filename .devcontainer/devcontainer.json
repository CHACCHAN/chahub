{
    "name": "ChaHub Dev",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
        "ghcr.io/chacchan/devcontainer-features/my-assets:latest": {},
        "ghcr.io/rails/devcontainer/features/bun:1": {},
        "ghcr.io/itsmechlark/features/postgresql:1": {
            "version": "18"
        },
        "ghcr.io/devcontainers-extra/features/cloudflared:1": {}
    },
    "workspaceFolder": "/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "runArgs": [
        "--env-file",
        ".devcontainer/devcontainer.env"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "eamodio.gitlens",
                "usernamehw.errorlens",
                "eamodio.gitlens",
                "streetsidesoftware.code-spell-checker",
                "Prisma.prisma"
            ],
            "settings": {
                "editor.tabSize": 2
            }
        }
    }
}
