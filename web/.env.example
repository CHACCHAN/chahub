# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL=postgresql://postgres@localhost:5432/chahub

LIVEKIT_URL=https://livekit.cc-chacchan.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed in addition to BETTER_AUTH_URL, comma-separated.
# Set this when opening the dev server from another device (e.g. a Free Kiosk tablet on the LAN).
# CHAHUB_TRUSTED_ORIGINS=http://192.168.1.20:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_DISCOVERY_URL=https://auth.example.com/application/o/chahub/.well-known/openid-configuration

# UserInfo claim containing an array of OIDC group names
AUTHENTIK_GROUPS_CLAIM=groups
