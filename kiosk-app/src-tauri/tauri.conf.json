{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChaHub Kiosk",
  "version": "0.1.0",
  "identifier": "com.chahub.kiosk",
  "build": {
    "beforeDevCommand": "cd ../web && bun run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://chahub.cc-chacchan.com"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ChaHub",
        "width": 800,
        "height": 600,
        "fullscreen": true
      }
    ],
    "security": {
      "capabilities": [
        "chahub"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
